# Usertour v2 API configuration.
# Copy this file to .env and fill in your token. .env is git-ignored.

# Personal API token: Usertour dashboard -> Settings -> Personal API keys.
# Required scopes: content:read, content:create, content:update, content:publish, theme:read
USERTOUR_API_TOKEN=utp_xxxxxxxxxxxxxxxxxxxxxxxx

# Base URL. Change only for a self-hosted Usertour instance.
USERTOUR_BASE_URL=https://api.usertour.io

# Optional. Pin a project id. If empty, the tool auto-selects the single
# project the token can access (and errors if the token spans several).
USERTOUR_PROJECT_ID=

# Optional. Default theme id used when a flow file does not set one.
USERTOUR_DEFAULT_THEME_ID=
